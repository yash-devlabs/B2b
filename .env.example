PORT=4002
# Leave blank to use the private .local-data file store during local development.
# Configure a MongoDB Atlas URI for production and Vercel deployments.
MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD_HASH=generate-with-npm-run-hash-password
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
# Optional persistent Cloudinary uploads (the gallery currently uses the supplied, optimized local photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
